{
  "manifest_version": 3,
  "name": "Coding Keyboard Simulator",
  "version": "1.0.0",
  "description": "Type or paste clipboard code into any web editor, with smart indent and bracket handling.",
  "permissions": [
    "activeTab",
    "scripting",
    "clipboardRead",
    "offscreen"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Coding Keyboard Simulator",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "human-type": {
      "suggested_key": {
        "default": "Alt+V"
      },
      "description": "Human typing"
    },
    "direct-paste": {
      "suggested_key": {
        "default": "Alt+Shift+V"
      },
      "description": "Direct paste"
    }
  },
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}